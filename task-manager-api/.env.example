# Copie para .env e preencha. Nunca commite o .env.

# Obrigatório. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Relativo a instance/ quando for sqlite:///arquivo.db
DATABASE_URL=sqlite:///tasks.db

DEBUG=false
HOST=0.0.0.0
PORT=5000

# "*" ou lista separada por vírgula: https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGINS=*

# Tamanho máximo do corpo da requisição, em bytes
MAX_CONTENT_LENGTH=1048576

# Validade do token emitido no /login, em segundos
TOKEN_MAX_AGE=28800
