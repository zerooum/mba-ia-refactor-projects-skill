# Copie para .env e preencha. Nunca commite o .env.
PORT=3000
# DEBUG=true liga o modo verbose do driver sqlite3.
DEBUG=false
# Padrão: banco em memória, recriado e semeado a cada boot.
DATABASE_URL=:memory:

# Chave do gateway de pagamento (obrigatória).
PAYMENT_GATEWAY_KEY=CHANGE_ME
# Token das rotas administrativas: header "Authorization: Bearer <ADMIN_TOKEN>" (obrigatório).
ADMIN_TOKEN=CHANGE_ME

# Rate limit do POST /api/checkout, por IP.
CHECKOUT_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
