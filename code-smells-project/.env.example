# Copie para .env e preencha. Nunca commite o .env.
SECRET_KEY=CHANGE_ME
DEBUG=false
HOST=0.0.0.0
PORT=5000
DB_PATH=loja.db
CORS_ORIGINS=*
AMBIENTE=producao
# Token exigido no header X-Admin-Token pelas rotas /admin/*. Vazio = rotas admin desabilitadas.
ADMIN_TOKEN=CHANGE_ME
# Senhas dos usuarios de exemplo criados no primeiro boot. Vazio = senha aleatoria (login desabilitado).
SEED_SENHA_ADMIN=CHANGE_ME
SEED_SENHA_JOAO=CHANGE_ME
SEED_SENHA_MARIA=CHANGE_ME
